{
  "name": "@span-sleuth/incident-intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
